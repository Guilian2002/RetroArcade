@{
    ViewData["Title"] = "INTERFACE_RETRO_ARCADE_V1";
}

<div class="container">
    <div class="arcade-card text-center">
        <h1 class="arcade-title blink">BIENVENUE_JOUEUR SUR LE SITE RETRO ARCADE</h1>

        <div class="mb-5" style="background: var(--neon-magenta); color: #000; font-size: 14px; padding: 10px; font-weight: bold; box-shadow: 0 0 15px var(--neon-magenta);">
            STATUT: EN LIGNE | SECTEUR: C-137 | PUISSANCE: MAX
        </div>

        <div class="mission-briefing mb-5" style="border-left: 4px solid var(--neon-cyan); padding-left: 20px; text-align: left;">
            <p style="color: var(--neon-cyan); font-size: 16px; text-transform: uppercase;">> OBJECTIF_DE_LA_MISSION:</p>
            <p style="color: #ccc; font-size: 14px;">IDENTIFIEZ-VOUS. AUCUN UTILISATEUR ANONYME NE POSSEDE L'ACCES AU RESEAU.</p>
        </div>

        <div class="d-flex flex-column gap-4 align-items-center mt-5">
            <a asp-controller="Account" asp-action="Create" class="btn-arcade">
                [ ENREGISTRER_UN_NOUVEAU_JOUEUR ]
            </a>
        </div>

        <div class="mt-5 pt-4" style="border-top: 1px solid rgba(0, 243, 255, 0.2); font-size: 10px; color: #444;">
            <p>CLE_DE_CRYPTAGE: AES-256-BIT // TERMINAL: @Environment.MachineName</p>
            <p class="mt-2">&copy; SYSTEME_RETRO_ARCADE_2026</p>
        </div>
    </div>
</div>