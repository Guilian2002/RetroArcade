@page "/rooms/add"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Manager")]

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="sab-card main-form-container">

                <div class="form-header-cyber mb-4">
                    <h2 class="retro-title">
                        <i class="bi bi-plus-square text-cyan me-2"></i>
                        NOUVEAU <span class="text-pink">SECTEUR</span>
                    </h2>
                    <div class="cyber-line"></div>
                </div>

                <EditForm Model="@_form" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-8 mb-4">
                            <label class="cyber-label">NOM DE LA SALLE</label>
                            <InputText @bind-Value="_form.Name" class="form-control cyber-input" placeholder="ex: Salle Néon" />
                            <ValidationMessage For="@(() => _form.Name)" class="validation-message" />
                        </div>
                        <div class="col-md-4 mb-4">
                            <label class="cyber-label">NUMÉRO ID</label>
                            <InputNumber @bind-Value="_form.Number" class="form-control cyber-input" />
                            <ValidationMessage For="@(() => _form.Number)" class="validation-message" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="cyber-label">CAPACITÉ MAX (MACHINES)</label>
                            <InputNumber @bind-Value="_form.MachineCapacity" class="form-control cyber-input" />
                            <ValidationMessage For="@(() => _form.MachineCapacity)" class="validation-message" />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="cyber-label">PRIX DE LOCATION (€)</label>
                            <InputNumber @bind-Value="_form.Price" class="form-control cyber-input" step="0.01" />
                            <ValidationMessage For="@(() => _form.Price)" class="validation-message" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert-cyber p-3 mb-4">
                            <i class="bi bi-shield-slash me-2"></i> @_errorMessage
                        </div>
                    }

                    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mt-5">
                        <button type="button" class="btn-cyber flex-grow-1" @onclick='() => Nav.NavigateTo($"/rooms/{BuildingId}")'>
                            ANNULER
                        </button>
                        <button type="submit" class="btn-cyber btn-cyber-pink flex-grow-1" disabled="@_isSubmitting">
                            @(_isSubmitting ? "INITIALISATION..." : "ENREGISTRER LA SALLE")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
