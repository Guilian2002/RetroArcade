@page "/buildings/details/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container mt-5">
    @if (_isLoading)
    {
        <div class="loader-container">
            <div class="cyber-spinner"></div>
            <p class="text-cyan mt-3">Interrogation de la base de données...</p>
        </div>
    }
    else if (_building == null)
    {
        <div class="alert-cyber p-3">
            <i class="bi bi-exclamation-octagon me-2"></i> @_errorMessage
        </div>
    }
    else
    {
        <!-- Breadcrumb Cyber -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb cyber-breadcrumb">
                <li class="breadcrumb-item"><a href="/buildings">BÂTIMENTS</a></li>
                <li class="breadcrumb-item active">@_building.Name.ToUpper()</li>
            </ol>
        </nav>

        <div class="row g-4">
            <!-- Sidebar : Informations du complexe -->
            <div class="col-lg-4">
                <div class="sab-card border-cyan h-100">
                    <div class="card-header-cyber mb-4">
                        <h5 class="retro-title-sm"><i class="bi bi-info-circle me-2"></i>INFORMATIONS</h5>
                    </div>

                    <div class="info-body">
                        <h4 class="text-pink mb-4 fw-bold">@_building.Name</h4>

                        <div class="info-item mb-4">
                            <label class="cyber-label-small">LOCALISATION</label>
                            <p class="text-white small">@_building.FullAddress</p>
                        </div>

                        <div class="info-item mb-4">
                            <label class="cyber-label-small">HORAIRES D'OUVERTURE</label>
                            <div class="badge-neon mt-1">
                                @($"{_building.OpeningHour.Hours:D2}:{_building.OpeningHour.Minutes:D2}") -
                                @($"{_building.ClosingHour.Hours:D2}:{_building.ClosingHour.Minutes:D2}")
                            </div>
                        </div>

                        <div class="cyber-divider mb-4"></div>

                        <label class="cyber-label-small">CONTACT SYSTÈME</label>
                        <p class="text-muted small mb-0">Manager : Responsable RetroArcade</p>
                    </div>
                </div>
            </div>

            <!-- Main Content : Liste des salles -->
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="retro-title-sm"><i class="bi bi-grid-3x3-gap me-2"></i>SALLES DISPONIBLES</h4>
                    <AuthorizeView Roles="Manager">
                        <a href="/rooms/add?buildingId=@_building.Id" class="btn-cyber btn-mini-cyber no-decoration">
                            <i class="bi bi-plus-lg me-1"></i> AJOUTER UNE SALLE
                        </a>
                    </AuthorizeView>
                </div>

                @if (_building.Rooms == null || !_building.Rooms.Any())
                {
                    <div class="alert-cyber text-center py-4">
                        AUCUN SECTEUR ENREGISTRÉ POUR CE COMPLEXE.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var room in _building.Rooms)
                        {
                            <div class="col-md-6">
                                <div class="room-item-cyber p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="text-white mb-0 fw-bold">@room.Name</h5>
                                            <span class="text-muted-cyber small">SECTEUR N°@room.Number</span>
                                        </div>
                                        <div class="price-tag">
                                            <span class="text-cyan fw-bold">@room.Price.ToString("C2", new System.Globalization.CultureInfo("fr-FR"))</span>
                                            <small class="text-muted">/h</small>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end mt-3">
                                        <a href="/rooms/details/@room.Id" class="btn-cyber btn-mini-cyber btn-cyber-pink no-decoration">
                                            DÉTAILS SECTEUR
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
