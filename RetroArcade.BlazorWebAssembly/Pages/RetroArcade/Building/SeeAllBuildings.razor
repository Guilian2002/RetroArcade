@page "/buildings"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container mt-5 @(showDeleteModal ? "blur-content" : "")">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="retro-title"><i class="bi bi-building me-3"></i>Nos Centres Arcade</h2>

        <AuthorizeView Roles="Manager">
            <a href="/buildings/add" class="btn-cyber btn-cyber-pink no-decoration">
                <i class="bi bi-plus-lg me-1"></i> Nouveau Bâtiment
            </a>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-cyber p-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <div class="loader-container">
            <div class="cyber-spinner"></div>
            <p class="mt-3 text-cyan">Accès au réseau...</p>
        </div>
    }
    else if (buildings == null || !buildings.Any())
    {
        <div class="sab-card text-center py-5">
            <p class="text-muted">Aucun complexe détecté.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var b in buildings)
            {
                <div class="col">
                    <div class="sab-card h-100 d-flex flex-column">
                        <div class="card-header-cyber mb-3">
                            <h5 class="building-name">@b.Name</h5>
                            <span class="badge-neon">
                                @($"{b.OpeningHour.Hours:D2}:{b.OpeningHour.Minutes:D2}") - @($"{b.ClosingHour.Hours:D2}:{b.ClosingHour.Minutes:D2}")
                            </span>
                        </div>

                        <div class="flex-grow-1">
                            <p class="address-text">
                                <i class="bi bi-geo-alt-fill text-pink me-2"></i>@b.FullAddress
                            </p>
                        </div>

                        <div class="card-actions-cyber mt-4">
                            <!-- NOUVEAU BOUTON : DETAILS -->
                            <button class="btn-cyber w-100 mb-2 btn-details" @onclick="() => NavigateToDetails(b.Id)">
                                <i class="bi bi-info-circle me-2"></i>INFOS CENTRE
                            </button>

                            <button class="btn-cyber w-100 mb-2" @onclick="() => NavigateToRooms(b.Id)">
                                <i class="bi bi-door-open me-2"></i>VOIR LES SALLES
                            </button>

                            <AuthorizeView Roles="Manager">
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn-cyber btn-mini flex-grow-1" @onclick="() => NavigateToUpdate(b.Id)">
                                        <i class="bi bi-pencil-square me-1"></i> MODIFIER
                                    </button>
                                    <button class="btn-cyber btn-cyber-pink btn-mini flex-grow-1 btn-delete-alarm"
                                            @onclick="() => OpenDeleteModal(b)">
                                        <i class="bi bi-trash3 me-1"></i> EFFACER
                                    </button>
                                </div>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showDeleteModal)
{
    <div class="cyber-modal-overlay">
        <div class="cyber-modal-container">
            <div class="cyber-modal-content">
                <h3 class="text-pink mb-4">ACCÈS RESTREINT</h3>
                <p>Confirmez-vous la suppression définitive de :</p>
                <p class="text-cyan fw-bold mt-2">[@buildingToDelete?.Name]</p>

                <div class="d-flex gap-3 mt-5">
                    <button class="btn-cyber flex-grow-1" @onclick="CloseDeleteModal">ANNULER</button>
                    <button class="btn-cyber btn-cyber-pink flex-grow-1" @onclick="ConfirmDelete">EFFACER</button>
                </div>
            </div>
        </div>
    </div>
}
