@page "/bookings/details/{Id:guid}"
@namespace RetroArcade.BlazorWebAssembly.Pages.RetroArcade.Booking
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="cyber-container mt-4">
    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="cyber-spinner"></div>
            <p class="mt-3 text-muted">SYNCHRONISATION DES DONNÉES...</p>
        </div>
    }
    else if (_booking == null)
    {
        <div class="alert-cyber">
            <i class="bi bi-shield-slash me-2"></i> @_errorMessage
        </div>
    }
    else
    {
        <div class="sab-card details-layout">
            <div class="details-header">
                <h2 class="retro-title m-0">
                    <i class="bi bi-ticket-perforated me-2"></i>Détails du Ticket
                </h2>
                <span class="cyber-badge @(_booking.Status.ToString().ToLower())">
                    @_booking.Status.ToString().ToUpper()
                </span>
            </div>

            <div class="details-content mt-4">
                <div class="row g-4">
                    <div class="col-md-6 section-divider">
                        <h5 class="cyber-h5"><i class="bi bi-cpu me-2"></i>Ma Session</h5>
                        <ul class="info-list">
                            <li><span class="label">DATE</span> <span class="value">@_booking.BeginDate.ToString("D")</span></li>
                            <li><span class="label">HORAIRE</span> <span class="value">@_booking.BeginDate.ToString("HH:mm") - @_booking.EndDate.ToString("HH:mm")</span></li>
                            <li><span class="label">GROUPE</span> <span class="value">@_booking.GroupSize PERSONNES</span></li>
                            <li class="price-row">
                                <span class="label">TOTAL</span>
                                <span class="value price">@_booking.Price.ToString("C2", new System.Globalization.CultureInfo("fr-FR"))</span>
                            </li>
                        </ul>
                    </div>

                    <div class="col-md-6 ps-md-4">
                        <h5 class="cyber-h5"><i class="bi bi-geo-alt me-2"></i>Localisation</h5>
                        <div class="location-box">
                            <p class="room-name">@_booking.Room.Name</p>
                            <p class="building-info">@_booking.Room.Building.Name — @_booking.Room.Building.City</p>
                        </div>

                        <div class="action-grid mt-4">
                            <AuthorizeView Roles="User">
                                @if (_booking.Status.ToString() == "OnGoing")
                                {
                                    <a href="/bookings/update/@_booking.Id" class="btn-cyber btn-cyber-pink w-100 mb-2">
                                        <i class="bi bi-pencil-square me-2"></i>MODIFIER LE GROUPE
                                    </a>
                                }
                            </AuthorizeView>
                            <button class="btn-cyber w-100" @onclick='() => Nav.NavigateTo("/buildings")'>
                                <i class="bi bi-arrow-left me-2"></i>RETOUR AUX CENTRES
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="scan-line"></div>
        </div>
    }
</div>
