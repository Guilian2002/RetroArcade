@page "/bookings/update/{Id:guid}"
@namespace RetroArcade.BlazorWebAssembly.Pages.RetroArcade.Booking
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "User")]

<div class="cyber-container mt-5">
    <div class="sab-card">
        @* Header Stylisé *@
        <div class="card-header-cyber">
            <h2 class="retro-title mb-0">
                <i class="bi bi-pencil-square me-2"></i>RECALIBRAGE UNITÉ
            </h2>
            <div class="status-line"></div>
        </div>

        <div class="card-body-cyber mt-4">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="cyber-spinner"></div>
                    <p class="mt-3 text-muted">ACCÈS AU NOYAU...</p>
                </div>
            }
            else
            {
                <EditForm Model="@_form" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    @* Alerte Info Cyber *@
                    <div class="cyber-alert-info mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <span>MODIFICATION RESTREINTE : Taille du groupe uniquement. Pour tout autre changement, initiez une nouvelle séquence (Annulation).</span>
                    </div>

                    @* Input Group Size *@
                    <div class="mb-4">
                        <label class="cyber-label">CAPACITÉ DU GROUPE (4 - 10 UNITÉS)</label>
                        <div class="input-wrapper">
                            <InputNumber @bind-Value="_form.GroupSize" class="form-control-cyber" placeholder="4" />
                            <div class="input-glow"></div>
                        </div>
                        <ValidationMessage For="@(() => _form.GroupSize)" class="cyber-validation" />
                    </div>

                    @if (_errorMessage != null)
                    {
                        <div class="alert-cyber mb-4">
                            <i class="bi bi-shield-exclamation me-2"></i> @_errorMessage
                        </div>
                    }

                    @* Actions *@
                    <div class="d-flex justify-content-between align-items-center mt-5">
                        <button type="button" class="btn-back" @onclick='() => Nav.NavigateTo("/my-bookings")'>
                            <i class="bi bi-arrow-left"></i> RETOUR
                        </button>

                        <button type="submit" class="btn-cyber @(_isSubmitting ? "loading" : "")" disabled="@_isSubmitting">
                            @(_isSubmitting ? "SYNCHRONISATION..." : "ENREGISTRER LES MODIFICATIONS")
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>
