@page "/arcademachines"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container mt-5 @(showDeleteModal ? "blur-content" : "")">
    <div class="d-flex justify-content-between align-items-center mb-5 section-header">
        <h2 class="retro-title"><i class="bi bi-joystick me-3"></i>Catalogue des Bornes</h2>
        <AuthorizeView Roles="Manager">
            <a href="/arcademachines/add" class="btn-cyber btn-cyber-pink no-decoration">
                <i class="bi bi-plus-lg me-1"></i> AJOUTER AU CATALOGUE
            </a>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert-cyber p-3 mb-4">
            <i class="bi bi-exclamation-octagon me-2"></i> @_errorMessage
        </div>
    }

    @if (_isLoading)
    {
        <div class="loader-container">
            <div class="cyber-spinner"></div>
            <p class="mt-3 text-cyan">Scanning du matériel...</p>
        </div>
    }
    else if (_machines == null || !_machines.Any())
    {
        <div class="sab-card text-center py-5">
            <p class="text-muted">Aucune unité détectée dans le hangar.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var m in _machines)
            {
                <div class="col">
                    <div class="sab-card h-100 d-flex flex-column">
                        <div class="card-header-cyber mb-3">
                            <h5 class="machine-name">@m.Name</h5>
                            <span class="badge-neon">@m.Categorie?.Name</span>
                        </div>

                        <div class="flex-grow-1">
                            <div class="game-info p-2 mb-3">
                                <span class="label-mini">LOGICIEL INSTALLÉ</span>
                                <div class="game-title text-pink">@m.GameName</div>
                            </div>
                        </div>

                        <div class="card-actions-cyber mt-3">
                            <AuthorizeView Roles="Manager">
                                <div class="d-flex gap-2">
                                    <button class="btn-cyber btn-mini flex-grow-1" @onclick='() => Nav.NavigateTo($"/arcademachines/update/{m.Id}")'>
                                        <i class="bi bi-pencil-square me-1"></i> MODIFIER
                                    </button>
                                    <button class="btn-cyber btn-cyber-pink btn-mini flex-grow-1 btn-delete-alarm" @onclick="() => OpenDeleteModal(m)">
                                        <i class="bi bi-trash3 me-1"></i> EFFACER
                                    </button>
                                </div>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showDeleteModal)
{
    <div class="cyber-modal-overlay">
        <div class="cyber-modal-container">
            <div class="cyber-modal-content text-center">
                <h3 class="text-pink mb-4">ALERTE DÉMANTÈLEMENT</h3>
                <p>Confirmer le retrait du catalogue de :</p>
                <p class="text-cyan fw-bold mt-2">[@machineToDelete?.Name]</p>

                <div class="d-flex gap-3 mt-5">
                    <button class="btn-cyber flex-grow-1" @onclick="CloseDeleteModal">ANNULER</button>
                    <button class="btn-cyber btn-cyber-pink flex-grow-1" @onclick="ConfirmDelete">CONFIRMER</button>
                </div>
            </div>
        </div>
    </div>
}
