@page "/arcademachines/add"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Manager")]

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="sab-card main-form-container">

                <div class="form-header-cyber mb-4">
                    <h2 class="retro-title">
                        <i class="bi bi-plus-square text-cyan me-2"></i>
                        NOUVELLE <span class="text-pink">BORNE</span>
                    </h2>
                    <div class="cyber-line"></div>
                </div>

                <EditForm Model="@_form" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="cyber-label">NOM DU MODÈLE</label>
                        <InputText @bind-Value="_form.Name" class="form-control cyber-input" placeholder="ex: Sega Astro City" />
                        <ValidationMessage For="@(() => _form.Name)" class="validation-message" />
                    </div>

                    <div class="mb-4">
                        <label class="cyber-label">JEU PRINCIPAL</label>
                        <InputText @bind-Value="_form.GameName" class="form-control cyber-input" placeholder="ex: Pac-Man" />
                        <ValidationMessage For="@(() => _form.GameName)" class="validation-message" />
                    </div>

                    <div class="mb-4">
                        <label class="cyber-label">CATÉGORIE SYSTEME</label>
                        <InputSelect @bind-Value="_form.CategorieId" class="form-select cyber-input">
                            <option value="">-- SÉLECTIONNER --</option>
                            @foreach (var cat in _categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _form.CategorieId)" class="validation-message" />
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert-cyber p-3 mb-4">
                            <i class="bi bi-shield-slash me-2"></i> @_errorMessage
                        </div>
                    }

                    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mt-5">
                        <button type="button" class="btn-cyber flex-grow-1" @onclick='() => Nav.NavigateTo("/arcademachines")'>
                            ANNULER
                        </button>
                        <button type="submit" class="btn-cyber btn-cyber-pink flex-grow-1" disabled="@_isSubmitting">
                            @(_isSubmitting ? "TRANSMISSION..." : "AJOUTER AU CATALOGUE")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
