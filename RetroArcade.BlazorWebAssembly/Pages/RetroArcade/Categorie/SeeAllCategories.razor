@page "/categories/list"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container mt-5 @(showDeleteModal ? "blur-content" : "")">
    <div class="d-flex justify-content-between align-items-center mb-5 section-header">
        <h2 class="retro-title"><i class="bi bi-tags me-3"></i>Base des Catégories</h2>

        <AuthorizeView Roles="Manager">
            <a href="/categories/add" class="btn-cyber btn-cyber-pink no-decoration">
                <i class="bi bi-plus-lg me-1"></i> Nouvelle Catégorie
            </a>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert-cyber p-3 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i> @_errorMessage
        </div>
    }

    @if (_isLoading)
    {
        <div class="loader-container">
            <div class="cyber-spinner"></div>
            <p class="mt-3 text-cyan">Indexation des tags...</p>
        </div>
    }
    else if (_categories == null || !_categories.Any())
    {
        <div class="sab-card text-center py-5">
            <p class="text-muted">Aucune catégorie répertoriée.</p>
        </div>
    }
    else
    {
        <div class="category-grid">
            @foreach (var cat in _categories)
            {
                <div class="category-row sab-card d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center">
                        <div class="category-icon-box me-3">
                            <i class="bi bi-hash text-cyan"></i>
                        </div>
                        <span class="category-name">@cat.Name</span>
                    </div>

                    <AuthorizeView Roles="Manager">
                        <button class="btn-cyber btn-mini btn-cyber-pink btn-delete-alarm" @onclick="() => OpenDeleteModal(cat)">
                            <i class="bi bi-trash3 me-2"></i> SUPPRIMER
                        </button>
                    </AuthorizeView>
                </div>
            }
        </div>
    }
</div>

@if (showDeleteModal)
{
    <div class="cyber-modal-overlay">
        <div class="cyber-modal-container">
            <div class="cyber-modal-content text-center">
                <h3 class="text-pink mb-4">ALERTE SYSTÈME</h3>
                <p>Voulez-vous vraiment effacer la catégorie :</p>
                <p class="text-cyan fw-bold mt-2">[@categoryToDelete?.Name]</p>

                <div class="d-flex gap-3 mt-5">
                    <button class="btn-cyber flex-grow-1" @onclick="CloseDeleteModal">ANNULER</button>
                    <button class="btn-cyber btn-cyber-pink flex-grow-1" @onclick="ConfirmDelete">EFFACER</button>
                </div>
            </div>
        </div>
    </div>
}
