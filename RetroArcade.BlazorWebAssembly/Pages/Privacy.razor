@page "/privacy"
@namespace RetroArcade.BlazorWebAssembly.Pages

<div class="privacy-container">
    <div class="sab-card">

        <header class="terminal-header">
            <h1 class="retro-title">> PROTOCOLE_CONFIDENTIALITÉ</h1>
            <div class="status-badge">
                [ STATUT : CHIFFREMENT_SÉCURITÉ_MAXIMAL ]
            </div>
        </header>

        <section class="policy-grid">
            <div class="policy-item">
                <div class="policy-label">> COLLECTE_DONNÉES</div>
                <div class="text-main">[ RESTREINTE ]</div>
            </div>
            <div class="policy-item">
                <div class="policy-label">> STATUT_COOKIES</div>
                <div class="text-main">[ ANONYMISÉS ]</div>
            </div>
        </section>

        <hr class="neon-divider" />

        <div class="legal-body mb-5">
            <p class="role-user">ARCHIVE_SÉCURISÉE :</p>
            <p>
                LES DONNÉES UTILISATEUR SONT PROTÉGÉES PAR LA GRILLE DE DÉFENSE
                <span class="role-manager">RETRO_ARCADE_SHIELD</span>.
                AUCUNE EXTRACTION EXTERNE N'EST AUTORISÉE SANS ACCRÉDITATION NIVEAU 5.
            </p>
        </div>

        <div class="text-center mt-4">
            <NavLink href="/" class="btn-cyber btn-cyber-pink">
                RETOUR_AU_HUB_PRINCIPAL
            </NavLink>
        </div>

        <footer class="terminal-footer mt-5 d-flex justify-content-between">
            <span>DERNIÈRE_MAJ : @_dateMaj</span>
            <span>SIGNATURE_SYSTÈME : @_signature</span>
        </footer>

    </div>
</div>
