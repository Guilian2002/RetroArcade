@page "/admin/accounts"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger"><i class="bi bi-shield-lock me-2"></i>Administration des Comptes</h2>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-warning border-danger">@_errorMessage</div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-danger"></div></div>
    }
    else if (_accounts == null || !_accounts.Any())
    {
        <div class="alert alert-info">Aucun compte trouvé.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-hover align-middle bg-white border">
                <thead class="table-dark">
                    <tr>
                        <th>Utilisateur</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Création</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in _accounts)
                    {
                        <tr class="@(!account.IsActive ? "table-secondary text-muted" : "")">
                            <td>
                                <div class="fw-bold">@account.Firstname @account.Lastname</div>
                                <small>@@@account.Username</small>
                            </td>
                            <td>@account.Email</td>
                            <td>
                                <span class="badge @(account.Role.ToString() == "Admin" ? "bg-danger" : account.Role.ToString() == "Manager" ? "bg-warning text-dark" : "bg-info")">
                                    @account.Role
                                </span>
                            </td>
                            <td>
                                @if (account.IsActive)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill"></i> Actif</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="bi bi-x-circle-fill"></i> Désactivé</span>
                                }
                            </td>
                            <td><small>@account.CreationDate?.ToString("dd/MM/yyyy")</small></td>
                            <td class="text-end px-4">
                                <button class="btn btn-sm btn-outline-primary me-1" title="Modifier"
                                        @onclick='() => Nav.NavigateTo($"/admin/accounts/update/{account.Id}")'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" title="Supprimer"
                                        @onclick="() => HandleDelete(account.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
