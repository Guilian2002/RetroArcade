@page "/admin/accounts"
@namespace RetroArcade.BlazorWebAssembly.Pages.Account
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<div class="cyber-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 header-terminal">
        <h2 class="retro-title m-0"><i class="bi bi-shield-lock me-2"></i>ADMINISTRATION DES COMPTES</h2>
        <div class="scanline-horizontal"></div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert-cyber mb-4">
            <i class="bi bi-terminal-x me-2"></i> ERREUR SYSTÈME : @_errorMessage
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="cyber-spinner"></div>
            <p class="mt-3 text-muted tracking-widest">SCAN DES ARCHIVES UTILISATEURS...</p>
        </div>
    }
    else if (_accounts == null || !_accounts.Any())
    {
        <div class="sab-card text-center py-5">
            <p class="text-muted">AUCUN COMPTE DÉTECTÉ DANS LA BASE DE DONNÉES.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="cyber-table">
                <thead>
                    <tr>
                        <th>UTILISATEUR</th>
                        <th>EMAIL / LOG</th>
                        <th>RÔLE</th>
                        <th>STATUT</th>
                        <th>CRÉATION</th>
                        <th class="text-end px-4">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in _accounts)
                    {
                        <tr class="row-entry @(!account.IsActive ? "account-disabled" : "")">
                            <td>
                                <div class="user-fullname">@account.Firstname @account.Lastname</div>
                                <code class="user-handle">@@@account.Username</code>
                            </td>
                            <td class="email-cell">@account.Email</td>
                            <td>
                                <span class="cyber-badge role-badge @(account.Role.ToString().ToLower())">
                                    @account.Role.ToString().ToUpper()
                                </span>
                            </td>
                            <td>
                                @if (account.IsActive)
                                {
                                    <span class="status-indicator active"><i class="bi bi-cpu-fill me-1"></i> ACTIF</span>
                                }
                                else
                                {
                                    <span class="status-indicator inactive"><i class="bi bi-pause-circle me-1"></i> DÉSACTIVÉ</span>
                                }
                            </td>
                            <td class="date-cell">@account.CreationDate?.ToString("dd/MM/yyyy")</td>
                            <td class="text-end px-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn-action btn-modify" title="Modifier"
                                            @onclick='() => Nav.NavigateTo($"/admin/accounts/update/{account.Id}")'>
                                        <i class="bi bi-pencil-square me-1"></i> MODIFIER
                                    </button>
                                    <button class="btn-action btn-delete" title="Supprimer"
                                            @onclick="() => OpenDeleteModal(account.Id, account.Username)">
                                        <i class="bi bi-trash3 me-1"></i> SUPPRIMER
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* MODALE DE CONFIRMATION *@
@if (_showDeleteModal)
{
    <div class="cyber-modal-overlay">
        <div class="cyber-modal">
            <div class="modal-header-cyber">
                <span class="retro-title text-pink">ALERTE SUPPRESSION</span>
            </div>
            <div class="modal-body-cyber text-center py-4">
                <p class="text-white">Confirmez-vous la révocation définitive de l'utilisateur :</p>
                <div class="target-name mt-3">[ @(_targetUsername?.ToUpper()) ]</div>
                <p class="text-muted-dark mt-4 small">Cette action effacera toutes les autorisations réseau associées.</p>
            </div>
            <div class="modal-footer-cyber">
                <button class="btn-cyber" @onclick="CloseDeleteModal">AVORTER</button>
                <button class="btn-cyber btn-cyber-pink" @onclick="ConfirmDelete">EFFACER LE COMPTE</button>
            </div>
        </div>
    </div>
}
