@page "/admin/accounts/update/{Id:guid}"
@namespace RetroArcade.BlazorWebAssembly.Pages.Account
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<div class="cyber-container mt-5">
    <div class="sab-card mx-auto">
        <div class="crt-scanline"></div>

        <div class="card-header-cyber mb-5">
            <h4 class="retro-title-sm mb-0">
                <i class="bi bi-person-gear me-2"></i>RECALIBRAGE DU PROFIL
            </h4>
            <div class="status-line"></div>
        </div>

        <div class="card-body-cyber">
            @if (_isLoading)
            {
                <div class="loader-box py-5 text-center">
                    <div class="cyber-spinner"></div>
                    <p class="text-cyan mt-3 tracking-widest">ACCÈS AU NOYAU...</p>
                </div>
            }
            else
            {
                <EditForm Model="@_form" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="cyber-label">PRÉNOM</label>
                            <div class="input-wrapper">
                                <InputText @bind-Value="_form.Firstname" class="form-control-cyber" />
                                <div class="corner-accent"></div>
                            </div>
                            <ValidationMessage For="@(() => _form.Firstname)" class="cyber-validation" />
                        </div>
                        <div class="col-md-6">
                            <label class="cyber-label">NOM</label>
                            <div class="input-wrapper">
                                <InputText @bind-Value="_form.Lastname" class="form-control-cyber" />
                                <div class="corner-accent"></div>
                            </div>
                            <ValidationMessage For="@(() => _form.Lastname)" class="cyber-validation" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="cyber-label">IDENTIFIANT RÉSEAU (PSEUDO)</label>
                        <div class="input-wrapper">
                            <InputText @bind-Value="_form.Username" class="form-control-cyber" />
                            <div class="corner-accent"></div>
                        </div>
                        <ValidationMessage For="@(() => _form.Username)" class="cyber-validation" />
                    </div>

                    <div class="mb-5">
                        <label class="cyber-label">NIVEAU D'ACCRÉDITATION (RÔLE)</label>
                        <div class="input-wrapper">
                            <InputSelect @bind-Value="_form.Role" class="form-select-cyber">
                                @foreach (var role in Enum.GetNames(typeof(Role)))
                                {
                                    <option value="@role">@role.ToUpper()</option>
                                }
                            </InputSelect>
                        </div>
                        <ValidationMessage For="@(() => _form.Role)" class="cyber-validation" />
                    </div>

                    @if (_errorMessage != null)
                    {
                        <div class="alert-cyber mb-4">
                            <i class="bi bi-shield-exclamation me-2"></i> @_errorMessage
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-5">
                        <button type="button" class="btn-annuler" @onclick='() => Nav.NavigateTo("/admin/accounts")'>
                            ANNULER
                        </button>
                        <button type="submit" class="btn-cyber btn-cyber-pink px-4" disabled="@_isSubmitting">
                            @(_isSubmitting ? "SYNC EN COURS..." : "ENREGISTRER LES MODIFICATIONS")
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>
